{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T98765SREDT/qa-sentinel/schema/suite-v2.json",
  "title": "QA Sentinel suite v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "tests"],
  "properties": {
    "schemaVersion": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "environment": {"type": "string", "maxLength": 80},
    "variables": {"type": "object"},
    "defaults": {"$ref": "#/$defs/defaults"},
    "workers": {"type": "integer", "minimum": 1, "maximum": 64},
    "slow_threshold_ms": {"type": "number", "minimum": 0},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/test"}
    }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_delay_seconds": {"type": "number", "minimum": 0, "maximum": 30},
        "retry_on_status": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "retry_non_idempotent": {"type": "boolean"}
      }
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "equals": {},
        "in": {"type": "array"},
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "not_equals": {},
        "contains": {},
        "max_ms": {"type": "number", "minimum": 0},
        "name": {"type": "string"},
        "value": {"type": "string"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "method": {"type": "string", "pattern": "^[A-Za-z]+$"},
        "url": {"type": "string", "format": "uri"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "json": {},
        "body": {},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_delay_seconds": {"type": "number", "minimum": 0, "maximum": 30},
        "retry_on_status": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "retry_non_idempotent": {"type": "boolean"},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"}
        },
        "run_if": {"enum": ["success", "always"]},
        "extract": {"type": "object"},
        "cleanup": {"type": "boolean"}
      }
    }
  }
}
